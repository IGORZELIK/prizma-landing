---
interface Props {
  t: Record<string, any>;
  title?: string;
  description?: string;
}

const { t } = Astro.props;
const lang = t.lang || 'en';
const title = Astro.props.title ?? t.seo.title;
const description = Astro.props.description ?? t.seo.description;

// Canonical is the page's own URL. Legal pages must not point at the language homepage.
// "/" is a copy of /de (and 301s there in production), so its canonical is /de.
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const canonical = path === '/' ? 'https://prizma.to/de' : `https://prizma.to${path}`;

// hreflang follows the concrete page, not always the homepage.
// /ru is noindex and is not part of the set. x-default is the German canonical URL.
const locale = path.match(/^\/(de|en|ru)(\/.*)?$/);
const suffix = locale?.[2] ?? '';
const deHref = `https://prizma.to/de${suffix}`;
const enHref = `https://prizma.to/en${suffix}`;
const emitHreflang = lang !== 'ru';
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />

  <!-- OG -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content="https://prizma.to/og-image.png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:url" content={canonical} />
  <meta property="og:type" content="website" />

  <!-- /ru stays reachable by direct link for existing clients, but is not promoted:
       out of hreflang, out of the language switcher, closed to search engines. -->
  {lang === 'ru' && <meta name="robots" content="noindex, nofollow" />}

  <!-- hreflang: same three links on every indexable language version of this path -->
  {emitHreflang && (
    <>
      <link rel="alternate" hreflang="de" href={deHref} />
      <link rel="alternate" hreflang="en" href={enHref} />
      <link rel="alternate" hreflang="x-default" href={deHref} />
    </>
  )}
  <link rel="canonical" href={canonical} />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content="https://prizma.to/og-image.png" />

  <!-- Preload critical fonts -->
  <link rel="preload" href={`/fonts/unbounded-900-${lang === 'ru' ? 'cyrillic' : 'latin'}.woff2`} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/outfit-400.woff2" as="font" type="font/woff2" crossorigin />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

</head>
<body>
  <!-- Background orbs -->
  <div class="orb orb-1"></div>
  <div class="orb orb-2"></div>
  <div class="orb orb-3"></div>

  <!-- Particle canvas -->
  <canvas id="particles" style="position:fixed;inset:0;z-index:0;pointer-events:none;"></canvas>

  <main>
    <slot />
  </main>

  <!-- Vercel Analytics (GDPR-compliant, no cookies) -->
  <script>
    import { inject } from '@vercel/analytics';
    inject();
  </script>

  <!-- GSAP -->
  <script>
    async function initAnimations() {
      try {
        const { gsap } = await import('gsap');
        const { ScrollTrigger } = await import('gsap/ScrollTrigger');
        gsap.registerPlugin(ScrollTrigger);

        // Universal reveal animation
        gsap.utils.toArray('.reveal').forEach((el: any) => {
          gsap.fromTo(el,
            { y: 24, opacity: 0 },
            {
              y: 0,
              opacity: 1,
              duration: 0.7,
              ease: 'power3.out',
              scrollTrigger: {
                trigger: el,
                start: 'top 85%',
              },
            }
          );
        });

        // Stagger groups
        document.querySelectorAll('[data-stagger]').forEach((group) => {
          const children = Array.from(group.children);
          gsap.fromTo(children,
            { y: 30, opacity: 0 },
            {
              y: 0,
              opacity: 1,
              duration: 0.6,
              stagger: 0.1,
              ease: 'power3.out',
              scrollTrigger: {
                trigger: group,
                start: 'top 80%',
              },
            }
          );
        });

        // Counter animation
        document.querySelectorAll('[data-count]').forEach((el: any) => {
          const target = parseInt(el.getAttribute('data-count') || '0');
          el.textContent = '0';
          gsap.to(el, {
            textContent: target,
            duration: 1.5,
            ease: 'power2.out',
            snap: { textContent: 1 },
            scrollTrigger: { trigger: el, start: 'top 80%' },
          });
        });

      } catch (e) {
        // If GSAP fails to load, make everything visible
        document.querySelectorAll('.reveal, [data-stagger] > *').forEach((el: any) => {
          el.style.opacity = '1';
          el.style.transform = 'none';
        });
      }
    }

    // Run after DOM is ready
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAnimations);
    } else {
      initAnimations();
    }
  </script>

  <!-- Particles (deferred to after first paint) -->
  <script>
    function initParticles() {
    const canvas = document.getElementById('particles') as HTMLCanvasElement;
    if (canvas) {
      const ctx = canvas.getContext('2d')!;
      let w = canvas.width = window.innerWidth;
      let h = canvas.height = window.innerHeight;
      const isMobile = window.innerWidth < 768;

      const colors = ['#8B5CF6', '#06B6D4', '#10B981', '#ffffff', '#ffffff', '#ffffff'];
      const count = isMobile ? 15 : 30;

      interface Particle { x: number; y: number; vx: number; vy: number; r: number; color: string; }
      const particles: Particle[] = [];

      for (let i = 0; i < count; i++) {
        particles.push({
          x: Math.random() * w,
          y: Math.random() * h,
          vx: (Math.random() - 0.5) * 0.4,
          vy: (Math.random() - 0.5) * 0.4,
          r: 0.5 + Math.random() * 1,
          color: colors[Math.floor(Math.random() * colors.length)],
        });
      }

      function draw() {
        ctx.clearRect(0, 0, w, h);

        // Connections (desktop only)
        if (!isMobile) {
          for (let i = 0; i < particles.length; i++) {
            for (let j = i + 1; j < particles.length; j++) {
              const dx = particles[i].x - particles[j].x;
              const dy = particles[i].y - particles[j].y;
              const dist = Math.sqrt(dx * dx + dy * dy);
              if (dist < 70) {
                ctx.strokeStyle = `rgba(255,255,255,${0.04 * (1 - dist / 70)})`;
                ctx.lineWidth = 0.5;
                ctx.beginPath();
                ctx.moveTo(particles[i].x, particles[i].y);
                ctx.lineTo(particles[j].x, particles[j].y);
                ctx.stroke();
              }
            }
          }
        }

        // Particles
        for (const p of particles) {
          p.x += p.vx;
          p.y += p.vy;
          if (p.x < 0 || p.x > w) p.vx *= -1;
          if (p.y < 0 || p.y > h) p.vy *= -1;

          ctx.beginPath();
          ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
          ctx.fillStyle = p.color;
          ctx.globalAlpha = 0.6;
          ctx.fill();
          ctx.globalAlpha = 1;
        }

        requestAnimationFrame(draw);
      }

      draw();

      window.addEventListener('resize', () => {
        w = canvas.width = window.innerWidth;
        h = canvas.height = window.innerHeight;
      });
    }
    }
    // Defer particles until after main content is painted
    if ('requestIdleCallback' in window) {
      requestIdleCallback(initParticles);
    } else {
      setTimeout(initParticles, 200);
    }
  </script>
</body>
</html>
