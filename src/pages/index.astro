---
// Root page. PRIZMA is a German service, so "/" serves German directly:
// visitors from DE/AT/CH see their language with no redirect and no flash of
// another language. Everyone else is routed to /en or /ru by the script below.

import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import VisualDemo from '../components/VisualDemo.astro';
import Modules from '../components/Modules.astro';
import WhyNow from '../components/WhyNow.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Showcase from '../components/Showcase.astro';
import ForWhom from '../components/ForWhom.astro';
import Roadmap from '../components/Roadmap.astro';
import Trust from '../components/Trust.astro';
import CtaForm from '../components/CtaForm.astro';
import Footer from '../components/Footer.astro';
import Stats from '../components/Stats.astro';
import '../styles/global.css';

import t from '../i18n/de.json';
---

<Layout t={t}>
  <Nav t={t} />
  <Hero t={t} />
  <VisualDemo t={t} />
  <hr class="divider" />
  <Modules t={t} />
  <hr class="divider" />
  <WhyNow t={t} />
  <Stats t={t} />
  <HowItWorks t={t} />
  <hr class="divider" />
  <Roadmap t={t} />
  <hr class="divider" />
  <Showcase t={t} />
  <hr class="divider" />
  <ForWhom t={t} />
  <hr class="divider" />
  <Trust t={t} />
  <hr class="divider" />
  <CtaForm t={t} />
  <Footer t={t} />
</Layout>

<script>
  // Language routing — runs only on the root page "/", which already serves German.
  const LOCALE_KEY = 'prizma_locale';

  if (window.location.pathname === '/') {
    const saved = localStorage.getItem(LOCALE_KEY);

    if (saved && saved !== 'de') {
      // Returning visitor who picked another language → send them there.
      window.location.replace(`/${saved}`);
    } else if (!saved) {
      // First visit: German-speaking regions stay here, everyone else is routed away.
      fetch('/api/geo')
        .then(r => r.json())
        .then(data => {
          const country = (data.country_code || '').toUpperCase();
          const ruCountries = ['RU', 'UA', 'BY', 'KZ', 'UZ', 'KG', 'TJ', 'TM', 'AZ', 'AM', 'GE', 'MD'];
          const deCountries = ['DE', 'AT', 'CH', 'LI', 'LU'];

          let lang = 'en';
          if (deCountries.includes(country)) lang = 'de';
          else if (ruCountries.includes(country)) lang = 'ru';

          if (lang !== 'de') {
            localStorage.setItem(LOCALE_KEY, lang);
            window.location.replace(`/${lang}`);
          }
          // German-region visitors stay on "/". Nothing is persisted, so the
          // stored value only ever reflects an explicit choice or a redirect.
        })
        .catch(() => {
          // Network error → no redirect; German stays on screen.
        });
    }
    // saved === 'de' → stay.
  }
</script>
