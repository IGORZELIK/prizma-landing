---
// Root page — GeoIP-based redirect
// For SSG, we render the English version by default
// and add client-side geo-detection to redirect

import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import VisualDemo from '../components/VisualDemo.astro';
import Modules from '../components/Modules.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Showcase from '../components/Showcase.astro';
import Roadmap from '../components/Roadmap.astro';
import CtaForm from '../components/CtaForm.astro';
import Footer from '../components/Footer.astro';
import Stats from '../components/Stats.astro';
import '../styles/global.css';

import t from '../i18n/en.json';
---

<Layout t={t}>
  <Nav t={t} />
  <Hero t={t} />
  <VisualDemo t={t} />
  <hr class="divider" />
  <Modules t={t} />
  <Stats t={t} />
  <HowItWorks t={t} />
  <hr class="divider" />
  <Roadmap t={t} />
  <hr class="divider" />
  <Showcase t={t} />
  <hr class="divider" />
  <CtaForm t={t} />
  <Footer t={t} />
</Layout>

<script>
  // Language routing — runs only on the root page "/".
  // Goal: visitors in DE/RU regions always land on their localized version, and
  // an explicit choice made via the language switcher is remembered and honored.
  const LOCALE_KEY = 'prizma_locale';

  if (window.location.pathname === '/') {
    const saved = localStorage.getItem(LOCALE_KEY);

    if (saved && saved !== 'en') {
      // Returning visitor with a stored non-English locale → send them there.
      window.location.replace(`/${saved}`);
    } else if (!saved) {
      // First visit: detect country and route accordingly.
      fetch('/api/geo')
        .then(r => r.json())
        .then(data => {
          const country = (data.country_code || '').toUpperCase();
          const ruCountries = ['RU', 'UA', 'BY', 'KZ', 'UZ', 'KG', 'TJ', 'TM', 'AZ', 'AM', 'GE', 'MD'];
          const deCountries = ['DE', 'AT', 'CH', 'LI', 'LU'];

          let lang = 'en';
          if (ruCountries.includes(country)) lang = 'ru';
          else if (deCountries.includes(country)) lang = 'de';

          if (lang !== 'en') {
            localStorage.setItem(LOCALE_KEY, lang);
            window.location.replace(`/${lang}`);
          }
          // English-region visitors stay on "/". We intentionally do not persist
          // "en" here, so the stored value only ever reflects an explicit choice.
        })
        .catch(() => {
          // Network error → no redirect; retry on the next visit.
        });
    }
    // saved === 'en' → explicit English choice → stay on "/".
  }
</script>
