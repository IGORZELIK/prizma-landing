---
// Root page. In production vercel.json 301s "/" to "/de" before this file is served,
// so Google does not crawl the German page twice. The markup stays in sync with /de
// for local preview, where that redirect is not applied. The script below only runs
// when this HTML is actually delivered: an explicit language choice, then the browser
// language, then the visitor's country. /ru is never chosen automatically.

import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import VisualDemo from '../components/VisualDemo.astro';
import Modules from '../components/Modules.astro';
import WhyNow from '../components/WhyNow.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Showcase from '../components/Showcase.astro';
import ForWhom from '../components/ForWhom.astro';
import Roadmap from '../components/Roadmap.astro';
import Pricing from '../components/Pricing.astro';
import Trust from '../components/Trust.astro';
import CtaForm from '../components/CtaForm.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
import Stats from '../components/Stats.astro';
import '../styles/global.css';

import t from '../i18n/de.json';
---

<Layout t={t} title={t.seo_home.title} description={t.seo_home.description}>
  <Nav t={t} />
  <Hero t={t} />
  <VisualDemo t={t} />
  <hr class="divider" />
  <Modules t={t} />
  <hr class="divider" />
  <WhyNow t={t} />
  <Stats t={t} />
  <HowItWorks t={t} />
  <hr class="divider" />
  <Showcase t={t} />
  <hr class="divider" />
  <ForWhom t={t} />
  <hr class="divider" />
  <Pricing t={t} />
  <hr class="divider" />
  <Roadmap t={t} />
  <hr class="divider" />
  <Trust t={t} />
  <hr class="divider" />
  <Faq t={t} />
  <hr class="divider" />
  <CtaForm t={t} />
  <Footer t={t} />
</Layout>

<script>
  // Language routing — runs only on the root page "/", which already serves German.
  // Order: an explicit choice in the language switcher, then the browser language,
  // then the visitor's country. Only the explicit choice is remembered: an automatic
  // redirect used to be stored too, so one visit through a VPN, iCloud Private Relay
  // or from abroad pinned that browser to /en for good.
  const LOCALE_KEY = 'prizma_lang';
  const LEGACY_KEY = 'prizma_locale'; // mixed explicit choices and redirects; dropped
  const DE_COUNTRIES = ['DE', 'AT', 'CH', 'LI', 'LU'];

  /** First of the browser's preferred languages that the site has, or null. */
  function browserLang(): 'de' | 'en' | null {
    for (const tag of navigator.languages || [navigator.language]) {
      const base = (tag || '').toLowerCase().split('-')[0];
      if (base === 'de' || base === 'en') return base;
    }
    return null;
  }

  function go(lang: string) {
    if (lang !== 'de') window.location.replace(`/${lang}`);
  }

  if (window.location.pathname === '/') {
    let saved: string | null = null;
    try {
      localStorage.removeItem(LEGACY_KEY);
      saved = localStorage.getItem(LOCALE_KEY);
    } catch {
      // Storage blocked → route as a first visit.
    }

    const fromBrowser = browserLang();
    if (saved === 'de' || saved === 'en') {
      go(saved);
    } else if (fromBrowser) {
      go(fromBrowser);
    } else {
      // Browser prefers neither German nor English: decide by country.
      fetch('/api/geo')
        .then(r => r.json())
        .then(data => {
          const country = (data.country_code || '').toUpperCase();
          go(DE_COUNTRIES.includes(country) ? 'de' : 'en');
        })
        .catch(() => {
          // Network error → no redirect; German stays on screen.
        });
    }
  }
</script>
