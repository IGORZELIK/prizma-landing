---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/global.css';
import t from '../../i18n/en.json';
---

<Layout t={t}>
  <Nav t={t} />
  <div class="legal-page">
    <div class="section-wrap">
      <h1>Imprint (Impressum)</h1>
      <p class="legal-date">Last updated: July 2026</p>

      <div class="legal-body">

        <p class="legal-note">This imprint is provided pursuant to German law (§ 5 DDG). In case of any discrepancy, the <a href="/de/impressum">German version</a> prevails.</p>

        <h2>Information pursuant to § 5 DDG</h2>
        <p>
          <strong>Igor Zelikovsky</strong><br/>
          Digitalkin AI (trade name)<br/>
          Bleicherfeldstraße 31<br/>
          33689 Bielefeld<br/>
          Germany
        </p>

        <h2>Contact</h2>
        <p>Email: <a href="mailto:contact@digitalkin.co">contact@digitalkin.co</a></p>

        <h2>Responsible for content pursuant to § 18 (2) MStV</h2>
        <p>Igor Zelikovsky (address as above)<br/>
        Email: <a href="mailto:contact@digitalkin.co">contact@digitalkin.co</a></p>

        <h2>Disclaimer</h2>
        <p>The contents of this website have been created with the greatest possible care. However, we assume no liability for the accuracy, completeness and timeliness of the content.</p>

        <h2>Copyright</h2>
        <p>The content and works created by the site operator on this website are subject to German copyright law. Reproduction, adaptation, distribution and any kind of exploitation outside the limits of copyright law require the written consent of the respective author or creator.</p>

        <h2>Consumer dispute resolution</h2>
        <p>We are neither willing nor obliged to participate in dispute resolution proceedings before a consumer arbitration board.</p>

      </div>
    </div>
  </div>
  <Footer t={t} />
</Layout>

<style>
  .legal-page { min-height: 80vh; }
  .legal-page h1 { margin-bottom: 8px; }
  .legal-date { color: var(--text-dim); font-size: 0.9rem; margin-bottom: 60px; }
  .legal-note { color: var(--text-dim); font-size: 0.85rem; margin-bottom: 32px; }
  .legal-body h2 { font-size: 1.2rem; margin-top: 40px; margin-bottom: 12px; color: var(--text-primary); }
  .legal-body p, .legal-body ul { color: var(--text-secondary, #9CA3AF); line-height: 1.8; font-size: 0.95rem; }
  .legal-body ul { padding-left: 20px; margin-top: 8px; }
  .legal-body li { margin-bottom: 6px; }
  .legal-body a { color: var(--purple); text-decoration: none; }
  .legal-body a:hover { text-decoration: underline; }
  .legal-body strong { color: var(--text-primary); }
</style>
