---
import PrismLogo from './PrismLogo.astro';

interface Props {
  t: Record<string, any>;
}
const { t } = Astro.props;
const headline = t.hero.h1 as string | undefined;
---

<section class="hero" id="hero">
  <PrismLogo />

  <h1 class:list={['hero-slogan', { 'hero-h1-long': Boolean(headline) }]}>{headline || t.hero.slogan}</h1>
  {headline && <p class="hero-subline">{t.hero.slogan}</p>}
  <p class="hero-subtitle">{t.hero.subtitle}</p>

  <div class="hero-cta">
    <a href="tel:+4952196377655" class="btn-primary"><span>{t.hero.cta_primary}</span></a>
    <a href="#contact" class="btn-secondary">{t.hero.cta_secondary}</a>
  </div>
  <p class="hero-phone">{t.hero.phone_hint}</p>

  <div class="scroll-hint" aria-hidden="true">
    <div class="scroll-line"></div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    z-index: 1;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 80px 24px 40px;
  }

  .hero-slogan {
    opacity: 1;
    background: linear-gradient(135deg, #fff 0%, #E5E7EB 50%, rgba(139, 92, 246, 0.9) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  /* Longer search headline. The short brand line stays underneath, not as the H1. */
  .hero-h1-long {
    font-size: clamp(1.7rem, 4.4vw, 3.15rem);
    line-height: 1.18;
    max-width: 16em;
    text-wrap: balance;
  }

  .hero-subline {
    font-family: 'Unbounded', sans-serif;
    font-weight: 700;
    font-size: clamp(1.05rem, 2.1vw, 1.45rem);
    line-height: 1.35;
    letter-spacing: -0.01em;
    color: var(--text-primary);
    margin-top: 18px;
    opacity: 0;
    animation: revealUp 0.5s ease-out 0.12s forwards;
  }

  .hero-subtitle {
    font-size: clamp(1.1rem, 2vw, 1.4rem);
    font-weight: 300;
    color: var(--text-secondary);
    max-width: 580px;
    line-height: 1.75;
    margin-top: 20px;
    opacity: 0;
    animation: revealUp 0.5s ease-out 0.18s forwards;
  }

  .hero-cta {
    display: flex;
    gap: 16px;
    margin-top: 40px;
    opacity: 0;
    animation: revealUp 0.5s ease-out 0.32s forwards;
  }

  .hero-phone {
    margin-top: 14px;
    font-size: 0.85rem;
    color: var(--text-dim);
    opacity: 0;
    animation: revealUp 0.5s ease-out 0.4s forwards;
  }

  .scroll-hint {
    position: absolute;
    bottom: 16px;
    left: 50%;
    transform: translateX(-50%);
    opacity: 0;
    animation: revealUp 0.5s ease-out 0.5s forwards;
  }

  .scroll-line {
    width: 1px;
    height: 24px;
    background: linear-gradient(to bottom, var(--purple), transparent);
    animation: scrollPulse 2s ease-in-out infinite;
  }

  @keyframes revealUp {
    from { opacity: 0; transform: translateY(24px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @keyframes scrollPulse {
    0%, 100% { opacity: 0.3; }
    50%      { opacity: 1; }
  }

  @media (max-width: 600px) {
    .hero-cta {
      flex-direction: column;
      width: 100%;
      max-width: 300px;
    }
    .hero-h1-long {
      font-size: clamp(1.45rem, 7.4vw, 1.9rem);
      max-width: 100%;
    }
    .scroll-hint { display: none; }
  }
</style>

<script>
  // Nav reveal via GSAP (after hero timeline)
  setTimeout(() => {
    const nav = document.getElementById('nav');
    if (nav) {
      nav.style.transition = 'opacity 0.6s ease-out, transform 0.6s ease-out';
      nav.style.opacity = '1';
      nav.style.transform = 'translateY(0)';
    }
  }, 450);
</script>
