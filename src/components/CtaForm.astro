---
interface Props {
  t: Record<string, any>;
}
const { t } = Astro.props;
---

<section class="cta-section" id="contact">
  <div class="section-wrap">
    <div class="cta-glow" aria-hidden="true"></div>

    <h2 class="reveal">{t.cta.heading}</h2>
    <p class="section-subtitle cta-sub reveal">{t.cta.subtitle}</p>

    <div class="sofie glass-card reveal">
      <img class="sofie-avatar" src="/sofie.webp" alt={t.sofie.alt} width="96" height="96" loading="lazy" />
      <div class="sofie-body">
        <div class="sofie-name">{t.sofie.name} <span class="sofie-role">{t.sofie.role}</span></div>
        <p class="sofie-text">{t.sofie.text}</p>
        <a href="tel:+4952196377655" class="btn-primary sofie-btn"><span>{t.hero.cta_primary} · +49 521 96377655</span></a>
      </div>
    </div>

    <div class="cta-form-wrap glass-card reveal">
      <form class="cta-form" data-astro-reload>
        <div class="form-row">
          <div class="form-field">
            <label class="form-label" for="cta-name">{t.cta.label_name}</label>
            <input
              id="cta-name"
              type="text"
              class="form-input"
              name="name"
              required
              autocomplete="name"
            />
          </div>
          <div class="form-field">
            <label class="form-label" for="cta-email">{t.cta.label_email}</label>
            <input
              id="cta-email"
              type="email"
              class="form-input"
              name="email"
              required
              autocomplete="email"
            />
          </div>
        </div>
        <div class="form-field">
          <label class="form-label" for="cta-company">
            {t.cta.label_company} <span class="form-optional">({t.cta.optional})</span>
          </label>
          <input
            id="cta-company"
            type="text"
            class="form-input"
            name="company"
            autocomplete="organization"
          />
        </div>
        <div class="form-field">
          <label class="form-label" for="cta-message">
            {t.cta.label_message} <span class="form-optional">({t.cta.optional})</span>
          </label>
          <textarea
            id="cta-message"
            class="form-input form-textarea"
            placeholder={t.cta.message}
            name="message"
            rows="4"
          ></textarea>
        </div>
        <!-- Honeypot: hidden from humans, bots fill it -> request is dropped server-side -->
        <input
          type="text"
          name="website"
          class="hp-field"
          tabindex="-1"
          autocomplete="off"
          aria-hidden="true"
        />
        <button type="submit" class="btn-primary submit-btn" data-label={t.cta.submit} data-sending={t.cta.sending}>
          <span>{t.cta.submit}</span>
        </button>
        <p class="form-error" role="alert" data-text={t.cta.error}></p>
      </form>

      <div class="form-success" role="status" tabindex="-1">
        <div class="success-icon">✓</div>
        <div class="success-title">
          {t.lang === 'ru' ? 'Заявка отправлена!' : t.lang === 'de' ? 'Anfrage gesendet!' : 'Request sent!'}
        </div>
        <div class="success-sub">
          {t.lang === 'ru' ? 'Мы свяжемся с вами в ближайшее время.' : t.lang === 'de' ? 'Wir melden uns in Kürze.' : 'We will get back to you shortly.'}
        </div>
      </div>

      <p class="cta-privacy">{t.cta.privacy}</p>
    </div>

    <div class="contacts glass-card reveal">
      <h3 class="contacts-heading">{t.cta.contacts.heading}</h3>
      <div class="contacts-grid">
        <div class="contact-row">
          <span class="contact-k">{t.cta.contacts.phone}</span>
          <a class="contact-v" href="tel:+4952196377655">+49 521 96377655</a>
        </div>
        <div class="contact-row">
          <span class="contact-k">{t.cta.contacts.email}</span>
          <a class="contact-v" href="mailto:contact@digitalkin.co">contact@digitalkin.co</a>
        </div>
        <div class="contact-row">
          <span class="contact-k">{t.cta.contacts.location}</span>
          <span class="contact-v">{t.cta.contacts.location_value}</span>
        </div>
        <div class="contact-row">
          <span class="contact-k">{t.cta.contacts.languages}</span>
          <span class="contact-v">{t.cta.contacts.languages_value}</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .sofie {
    max-width: 640px;
    margin: 0 auto 32px;
    padding: 32px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    text-align: center;
  }

  .sofie-avatar {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
    border: 2px solid rgba(139, 92, 246, 0.5);
    box-shadow: 0 0 32px rgba(139, 92, 246, 0.25);
  }

  .sofie-name {
    font-weight: 600;
    font-size: 1.15rem;
    color: var(--text-primary);
  }

  .sofie-role {
    display: block;
    margin-top: 2px;
    font-size: 0.75rem;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-dim);
  }

  .sofie-text {
    max-width: 480px;
    margin: 12px auto 20px;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .sofie-btn {
    padding: 14px 28px;
  }

  @media (max-width: 600px) {
    .sofie { padding: 24px 20px; }
    .sofie-btn { width: 100%; }
  }

  .contacts {
    max-width: 640px;
    margin: 32px auto 0;
    padding: 28px 32px;
    text-align: left;
  }

  .contacts-heading {
    font-size: 0.95rem;
    font-weight: 600;
    margin: 0 0 18px;
    color: var(--text-secondary, #9CA3AF);
  }

  .contacts-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px 24px;
  }

  .contact-row {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }

  .contact-k {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-dim);
  }

  .contact-v {
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--text-primary);
    overflow-wrap: anywhere;
  }

  a.contact-v { color: var(--purple); text-decoration: none; }
  a.contact-v:hover { text-decoration: underline; }

  @media (max-width: 600px) {
    .contacts { padding: 22px 20px; }
    .contacts-grid { grid-template-columns: 1fr; }
  }

  .cta-section {
    position: relative;
    z-index: 1;
    text-align: center;
    overflow: hidden;
  }

  .cta-section h2 {
    margin-bottom: 0;
  }

  .cta-sub {
    margin: 16px auto 48px;
    text-align: center;
  }

  .cta-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 600px;
    height: 600px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(139, 92, 246, 0.1), transparent 70%);
    pointer-events: none;
  }

  .cta-form-wrap {
    max-width: 640px;
    margin: 0 auto;
    padding: 40px;
    position: relative;
    z-index: 2;
  }

  .cta-form {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .form-row {
    display: flex;
    gap: 16px;
  }

  .form-field {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
    text-align: left;
  }

  .form-label {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-secondary);
  }

  .form-optional {
    font-weight: 400;
    color: var(--text-dim);
  }

  .form-input {
    width: 100%;
    padding: 16px 20px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border-glass);
    border-radius: 12px;
    color: var(--text-primary);
    font-size: 1rem;
    transition: border-color 0.3s, box-shadow 0.3s;
    outline: none;
  }

  .form-input::placeholder {
    color: var(--text-dim);
  }

  .form-input:focus {
    border-color: rgba(139, 92, 246, 0.5);
    box-shadow: 0 0 20px rgba(139, 92, 246, 0.1);
  }

  .form-textarea {
    resize: vertical;
    min-height: 100px;
  }

  /* Honeypot: visually and physically hidden, but present in the DOM for bots. */
  .hp-field {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .submit-btn {
    width: 100%;
    margin-top: 8px;
    padding: 18px;
    font-size: 1.05rem;
  }

  .form-error {
    font-size: 0.9rem;
    color: #FCA5A5;
    text-align: center;
  }

  .form-error:empty { display: none; }

  .submit-btn:disabled {
    opacity: 0.6;
    cursor: wait;
    transform: none;
  }

  .form-success:focus { outline: none; }

  .cta-privacy {
    margin-top: 16px;
    font-size: 0.8rem;
    color: var(--text-dim);
  }

  @media (max-width: 600px) {
    .form-row { flex-direction: column; }
    .cta-form-wrap { padding: 28px 20px; }
  }
</style>

<script>
  const form = document.querySelector('.cta-form') as HTMLFormElement;
  const successBlock = document.querySelector('.form-success') as HTMLElement;
  const submitBtn = form?.querySelector('.submit-btn') as HTMLButtonElement;
  const submitLabel = submitBtn?.querySelector('span') as HTMLElement;
  const errorBox = form?.querySelector('.form-error') as HTMLElement;

  // Texts come from the page's dictionary, so the messages match the page language.
  function setSending(sending: boolean) {
    submitBtn.disabled = sending;
    submitBtn.classList.toggle('loading', sending);
    submitLabel.textContent = (sending ? submitBtn.dataset.sending : submitBtn.dataset.label) || '';
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (submitBtn.disabled) return;
    errorBox.textContent = '';
    setSending(true);

    const data = new FormData(form);

    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name: data.get('name') || '',
          email: data.get('email') || '',
          company: data.get('company') || '',
          message: data.get('message') || '',
          website: data.get('website') || '',
        }),
      });

      if (res.ok) {
        form.classList.add('hidden');
        successBlock.classList.add('visible');
        // The form disappears, so move focus to the confirmation and let screen readers read it.
        successBlock.focus();
      } else {
        throw new Error('Send failed');
      }
    } catch {
      setSending(false);
      errorBox.textContent = errorBox.dataset.text || '';
    }
  });
</script>

<style>

  .form-success {
    display: none;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    padding: 40px 20px;
  }

  .form-success.visible { display: flex; }
  .cta-form.hidden { display: none; }

  .success-icon {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: rgba(16, 185, 129, 0.15);
    border: 1px solid rgba(16, 185, 129, 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #10B981;
    font-size: 1.5rem;
  }

  .success-title {
    font-weight: 600;
    font-size: 1.1rem;
    color: var(--text-primary);
  }

  .success-sub {
    font-size: 0.9rem;
    color: var(--text-dim);
  }

  .submit-btn.loading {
    opacity: 0.6;
    pointer-events: none;
  }
</style>
