---
interface Props {
  t: Record<string, any>;
}
const { t } = Astro.props;
if (!t.for_whom) return;

const icons = [
  // travel agencies
  `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>`,
  // online shops
  `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>`,
  // hotels
  `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18"/><path d="M5 21V7l7-4 7 4v14"/><path d="M10 21v-5h4v5"/></svg>`,
  // schools and kindergartens
  `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10 12 5 2 10l10 5 10-5z"/><path d="M6 12v5c3 2.5 9 2.5 12 0v-5"/></svg>`,
  // manufacturing and trade
  `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/></svg>`,
  // agencies and resellers
  `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>`,
];
const colors = ['#8B5CF6', '#06B6D4', '#10B981', '#F59E0B', '#EC4899', '#3B82F6'];
---

<section class="for-whom" id="use-cases">
  <div class="section-wrap">
    <h2 class="reveal">{t.for_whom.heading}</h2>
    <div class="whom-grid" data-stagger>
      {t.for_whom.items.map((item: any, i: number) => (
        <div class="whom-card glass-card" style={`--accent: ${colors[i % colors.length]};`}>
          <div class="whom-icon" set:html={icons[i % icons.length]} />
          <div class="whom-title">{item.title}</div>
          <div class="whom-desc">{item.desc}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .whom-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    margin-top: 60px;
  }

  .whom-card {
    padding: 36px 32px;
    position: relative;
    border-left: 2px solid var(--accent);
    transition: box-shadow 0.3s, background 0.3s;
  }

  .whom-card:hover {
    background: rgba(255,255,255,0.06);
    box-shadow: 0 8px 40px rgba(0,0,0,0.3), 0 0 30px color-mix(in srgb, var(--accent) 10%, transparent);
  }

  .whom-icon {
    color: var(--accent);
    margin-bottom: 16px;
  }

  .whom-title {
    font-weight: 600;
    font-size: 1.05rem;
    color: var(--text-primary);
    margin-bottom: 10px;
  }

  .whom-desc {
    font-size: 0.9rem;
    color: var(--text-dim, #6B7280);
    line-height: 1.7;
  }

  @media (max-width: 768px) {
    .whom-grid { grid-template-columns: 1fr; }
  }
</style>
